# Hector — env template. Copy to `.env` and fill in.
# The panel is a single-admin proxy in front of the Hetzner Cloud API.

# Hetzner Cloud API token (read + write). Required for anything to work.
HCLOUD_TOKEN=

# Optional proxy for ALL outgoing api.hetzner.cloud requests. When set there
# is no direct fallback: if the proxy is down, requests fail.
#   HTTP(S) proxy:  http://USER:PASS@host:port
#   SOCKS5 proxy:   socks5://USER:PASS@host:port
#   no auth:        socks5://127.0.0.1:1080   (bare host:port = SOCKS5)
# URL-encode @ : / # ? inside the password. (SOCKS_PROXY still works as an alias.)
PROXY_URL=

# Optional API base override — development against a local mock only.
# HCLOUD_API_URL=http://127.0.0.1:9999/v1

# The single admin account (checked by POST /api/auth/login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HS256 signing secret for sessions. When empty a random one is generated at
# boot, which invalidates sessions on every restart.
JWT_SECRET=

# Bind address.
API_HOST=0.0.0.0
API_PORT=8787
